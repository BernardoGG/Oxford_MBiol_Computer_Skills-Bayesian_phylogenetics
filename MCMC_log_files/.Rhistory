getwd()
knitr::opts_chunk$set(echo = TRUE)
#Set working directory via session at the top of the screen, then check
setwd("/Users/user/Library/CloudStorage/OneDrive-Nexus365/Documents_Oxford/Mbio_Jan_2025/Marking_Q5/Q5\ Bayesian\ phylogenetics\ and\ Epidemiology")
# List of required packages
required_packages <- c(
"rmarkdown", "tinytex", "tidyverse", "ggtree",
"ggridges", "treeio", "coda", "cols4all")
#This installed the ggtree package which R said was missing
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("ggtree")
# Install missing packages
missing_packages <- required_packages[!(required_packages %in% installed.packages()[,"Package"])]
if(length(missing_packages)) {
install.packages(missing_packages)
}
# Load libraries
lapply(required_packages, library, character.only = TRUE)
# Load the MCC tree
beast_file <- ("MCC_CHIKV_IndianOcean.tree")
beast_tree <- treeio::read.beast(beast_file)
# Plot the base tree
ggtree(beast_tree)
# Add temporal scale
ggtree(beast_tree, mrsd = "2018-10-16") + theme_tree2()
#mrsd parameter specifies the most recent sampling date
#Each tip on this tree represents virus sample from an infected individual
# Add grid lines so easier to see timing (eg  when outbreaks and branching events happened)
ggtree(beast_tree, mrsd = "2018-10-16") + theme_tree2() +
scale_x_continuous(
breaks = c(2002, 2004, 2006, 2008, 2010, 2012, 2014, 2016, 2018),
minor_breaks = seq(2004, 2019, 1)
) +
theme(
panel.grid.major = element_line(color = "black", size = .1),
panel.grid.minor = element_line(color = "grey", size = .1),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
# Add sequence names
ggtree(beast_tree, mrsd = "2018-10-16") + theme_tree2() + geom_tiplab(size = 1.5) +
scale_x_continuous(
breaks = c(2002, 2004, 2006, 2008, 2010, 2012, 2014, 2016, 2018),
minor_breaks = seq(2004, 2019, 1)
) +
theme(
panel.grid.major = element_line(color = "black", size = .1),
panel.grid.minor = element_line(color = "grey", size = .1),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
geom_tiplab(size = 1.5) #Increase font size so the tip labels are more legible
# Colour the tree to show the Kassala outbreak lineage
# Highlight the parts of this tree that correspond to this epidemic
# Outbreak is a categorical variable, so ggtree automatically assigns a different colour for "Other"
ggtree(beast_tree, aes(color = outbreak), mrsd = "2018-10-16") + theme_tree2() +
scale_x_continuous(
breaks = c(2002, 2004, 2006, 2008, 2010, 2012, 2014, 2016, 2018),
minor_breaks = seq(2004, 2019, 1)
) +
theme(
panel.grid.major = element_line(color = "black", size = .1),
panel.grid.minor = element_line(color = "grey", size = .1),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
# Identify the MRCA of the Kassala outbreak
ggtree(beast_tree, aes(color = outbreak), mrsd="2018-10-16") + theme_tree2() +
scale_x_continuous(breaks = c(2002, 2004, 2006, 2008, 2010, 2012, 2014, 2016, 2018),
minor_breaks = seq(2004, 2019, 1)) +
geom_point2(aes(subset = (node == 255)), shape = 21, size = 3, fill = 'darkblue') +
theme(panel.grid.major = element_line(color = "black", size = .1),
panel.grid.minor = element_line(color = "grey", size = .1),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank())
#color=country means each different country gets assigned a separate colour in the phylogeny
ggtree(beast_tree, aes(color = country), mrsd="2018-10-16") + theme_tree2() +
scale_x_continuous(breaks = c(2002, 2004, 2006, 2008, 2010, 2012, 2014, 2016, 2018),
minor_breaks = seq(2004, 2019, 1)) +
scale_color_discrete_c4a_cat("classic20") +
theme(panel.grid.major = element_line(color = "black", size = .1),
panel.grid.minor = element_line(color = "grey", size = .1),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank())
